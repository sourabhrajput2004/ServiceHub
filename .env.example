# SERVER ONLY. Never rename these to VITE_* or commit real values.
# Razorpay TEST credentials from your own dashboard. Live keys are rejected.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Use your actual shop id. Default demo owner shop is shop_1.
PAYMENT_SHOP_ID=shop_1
PAYMENT_API_HOST=127.0.0.1
PAYMENT_API_PORT=3001
PUBLIC_APP_URL=http://localhost:3000

# Localhost can connect a local test payment desk without a password.
# Set a unique >=16 character password BEFORE using a public HTTPS URL.
PAYMENT_OPERATOR_PASSWORD=

# Optional public HTTPS origin for customer PDF links only.
# Local testing can instead use .data/bill-public-url.txt from the approved temporary tunnel.
BILL_PUBLIC_URL=
